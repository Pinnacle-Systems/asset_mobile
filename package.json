{
  "name": "@app/root",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rimraf .turbo node_modules",
    "verify": "pnpm run lint && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "eslint": "^8.57.0",
    "prettier": "^3.3.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.0.0"
  },
  "dependencies": {
    "dotenv": "^16.4.1",
     "moment": "^2.30.1"
  },
  "pnpm": {
    "overrides": {
      "yargs": "^17.7.2"
    }
  }
}
