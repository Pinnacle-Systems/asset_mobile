DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE"
PORT=4000
NODE_ENV=development
CORS_ORIGIN=*
ORACLE_PAYROLL_USER=PAYROLL_ORACLE_USER
ORACLE_PAYROLL_PASSWORD=PAYROLL_ORACLE_PASSWORD
ORACLE_PAYROLL_CONNECT_STRING=HOST:PORT/SERVICE_NAME
ORACLE_ASSET_USER=ASSET_ORACLE_USER
ORACLE_ASSET_PASSWORD=ASSET_ORACLE_PASSWORD
ORACLE_ASSET_CONNECT_STRING=HOST:PORT/SERVICE_NAME
ADMIN_SEED_PASSWORD=CHANGE_ME

