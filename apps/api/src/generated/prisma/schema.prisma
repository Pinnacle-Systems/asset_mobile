// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model settings {
  SettingId    Int      @id @default(autoincrement())
  UserId       String   @unique
  user         User     @relation(fields: [UserId], references: [Idcard])
  Notification Boolean?
  BioMatrics   Boolean?
  COMPCODE     String?
}

//Used
model User {
  id              Int           @id @default(autoincrement())
  username        String        @unique
  pic             String?
  email           String?
  otpemail        String?
  approval        String        @default("HOD")
  password        String?
  Idcard          String?       @unique
  role            Role?         @relation(fields: [roleId], references: [name], onDelete: SetNull)
  roleId          String?
  otp             String?
  hod             String?
  hr              String?
  level           String        @default("user")
  verificationOtp String?
  expiresAt       DateTime?
  createdAt       DateTime?     @default(now())
  active          Boolean       @default(true)
  employeeId      Int?
  isAllParty      Boolean       @default(false)
  isAdmin         Boolean       @default(false)
  fcm             String?       @default("")
  Companies       CompanyCode[]

  settings settings[]
}

model CompanyCode {
  id          Int     @id @default(autoincrement())
  Idcard      String
  companyCode String
  GCOMP       String?
  User        User    @relation(fields: [Idcard], references: [Idcard], onDelete: Cascade)
  companyid   String

  @@index([Idcard])
}

model Role {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  COMPCODE    String       @default("")
  User        User[]
  RoleOnPage  RoleOnPage[] @relation("RoleToRoleOnPage")
  active      String       @default("Yes")
  defaultRole Boolean      @default(false)
}

model RoleOnPage {
  id        Int     @id @default(autoincrement())
  role      Role    @relation("RoleToRoleOnPage", fields: [roleName], references: [name], onDelete: Cascade)
  roleId    Int?
  roleName  String
  read      Boolean @default(false)
  create    Boolean @default(false)
  edit      Boolean @default(false)
  link      String
  delete    Boolean @default(false)
  isdefault Boolean @default(false)
}

model UserLog {
  id         Int      @id @default(autoincrement())
  User       String?
  MobileName String?
  date       DateTime @default(now())
  MobileIP   String?
  type       String
  Idcard     String?
  COMPCODE   String?
}
