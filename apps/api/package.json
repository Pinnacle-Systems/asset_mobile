{
  "name": "@app/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "build": "node -e \"console.log('Build step not required for JavaScript API yet')\"",
    "lint": "eslint src test --ext .js --config ../../tooling/eslint/node.js",
    "test": "vitest run",
    "clean": "rimraf dist build .turbo coverage",
    "db:generate": "pnpm prisma generate",
    "db:migrate": "pnpm prisma migrate dev",
    "db:deploy": "pnpm prisma migrate deploy",
    "db:reset": "pnpm prisma migrate reset",
    "db:push": "pnpm prisma db push",
    "db:pull": "pnpm prisma db pull",
    "db:seed": "pnpm prisma db seed",
    "db:studio": "pnpm prisma studio",
    "db:status": "pnpm prisma migrate status",
    "db:format": "pnpm prisma format"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prisma/client-runtime-utils": "^7.8.0",
    "@repo/api-client": "workspace:*",
    "@repo/contracts": "workspace:*",
    "@repo/errors": "workspace:*",
    "@repo/logger": "workspace:*",
    "@repo/validation": "workspace:*",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.21.1",
    "mariadb": "^3.5.3",
    "moment": "^2.30.1",
    "nodemailer": "^9.0.1",
    "oracledb": "^7.0.0",
    "uuid": "^14.0.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@prisma/config": "^7.8.0",
    "@repo/eslint-config": "workspace:*",
    "prisma": "^7.8.0",
    "supertest": "^7.0.0",
    "tsx": "^4.22.4",
    "vitest": "^2.1.4"
  }
}
